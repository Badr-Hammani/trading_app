# ---------------------------------------------------------------------------
# XAUUSD Command Center — environment
#
# Copy to .env and fill in what you have. NOTHING here is required for the
# core workflow: charts from imported CSV, levels, FVGs, the setup checklist,
# risk calculator, journal, replay, backtesting and statistics all work with
# no API keys at all. Keys only add live data on top.
#
# Never commit a filled-in .env.
# ---------------------------------------------------------------------------

# Database (required) --------------------------------------------------------
DATABASE_URL="postgresql://xau:xau@localhost:5432/xau_command_center?schema=public"

# Auth (required) ------------------------------------------------------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=""
# Set to true behind HTTPS so the session cookie is marked Secure.
AUTH_COOKIE_SECURE="false"

# Defaults -------------------------------------------------------------------
DEFAULT_TIMEZONE="Africa/Casablanca"
DEFAULT_SYMBOL="XAUUSD"

# Market data (optional) -----------------------------------------------------
# Which provider to try first: "oanda" or "alpha-vantage".
MARKET_DATA_PROVIDER="oanda"
MARKET_DATA_API_KEY=""

# OANDA v20 — the only configured source with a real bid/ask, so the only one
# that can show a genuine spread.
OANDA_API_KEY=""
OANDA_ACCOUNT_ID=""
OANDA_ENVIRONMENT="practice"

# Alpha Vantage — optional alternative. Free tier is heavily rate limited.
ALPHA_VANTAGE_API_KEY=""

# Economic calendar (optional) -----------------------------------------------
# Format: client:key. Point-in-time snapshots are used for backtests so a
# historical run never sees a later revision.
TRADING_ECONOMICS_API_KEY=""

# Official US macro series for the Gold macro panel (optional).
FRED_API_KEY=""

# AI mentor (optional) -------------------------------------------------------
# Without a key the AI Mentor page explains what it would need; nothing else
# is affected.
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-4-5"

# Telegram bot (optional) ----------------------------------------------------
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Uploads --------------------------------------------------------------------
UPLOAD_DIR="./uploads"

# ---------------------------------------------------------------------------
# XAUUSD Command Center — environment
#
# Copy to .env and fill in what you have. NOTHING here is required for the
# core workflow: charts from imported CSV, levels, FVGs, the setup checklist,
# risk calculator, journal, replay, backtesting and statistics all work with
# no API keys at all. Keys only add live data on top.
#
# Never commit a filled-in .env.
# ---------------------------------------------------------------------------

# Database (required) --------------------------------------------------------
DATABASE_URL="postgresql://xau:xau@localhost:5432/xau_command_center?schema=public"

# Auth (required) ------------------------------------------------------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=""
# Set to true behind HTTPS so the session cookie is marked Secure.
AUTH_COOKIE_SECURE="false"

# Defaults -------------------------------------------------------------------
DEFAULT_TIMEZONE="Africa/Casablanca"
DEFAULT_SYMBOL="XAUUSD"

# Market data (optional) -----------------------------------------------------
# Which provider to try first: "oanda" or "alpha-vantage".
MARKET_DATA_PROVIDER="oanda"
MARKET_DATA_API_KEY=""

# OANDA v20 — FREE with a practice account (no funding required, but identity
# verification is). The only configured source with a real bid/ask, so the only
# one that can show a genuine spread. Token: fxTrade portal, My Services ->
# Manage API Access.
OANDA_API_KEY=""
OANDA_ACCOUNT_ID=""
OANDA_ENVIRONMENT="practice"

# Alpha Vantage — optional alternative. The free tier is only ~25 requests per
# DAY, which will not sustain a live dashboard; treat it as a fallback or for
# occasional history pulls. Paid plans start around $50/month.
ALPHA_VANTAGE_API_KEY=""

# Economic calendar (optional) -----------------------------------------------
# Trading Economics — PAID. Sign up at developer.tradingeconomics.com; the
# format is client:key. The old guest:guest sample account no longer works on
# the REST API. Adding events by hand under Calendar costs nothing and drives
# the same countdown, warning band and news filter.
TRADING_ECONOMICS_API_KEY=""

# FRED — FREE, and the best-value key here. Powers the whole macro panel:
# DXY, 2Y/10Y, real yields, Fed funds, CPI, PCE, payrolls, VIX, oil, S&P.
# Get one at fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=""

# AI mentor (optional) -------------------------------------------------------
# Pay-per-use, no subscription. Only the AI Mentor page uses it, and only when
# you press a button, so cost tracks how often you actually ask it something.
# Cheaper alternatives: claude-sonnet-5, or claude-haiku-4-5 for the lowest cost.
# Get a key at console.anthropic.com
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-5"

# Telegram bot (optional) ----------------------------------------------------
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Uploads --------------------------------------------------------------------
UPLOAD_DIR="./uploads"
